# Pact — environment. Copy to .env.local. Every key is optional: a missing
# provider shows as unavailable instead of stopping the app.

# Logging mode only. Both modes use real providers; a run with no responding
# model fails with a clear error.
PACT_MODE=development

# Language models. Auto routing: light jobs → Groq → Gemini → OpenRouter;
# heavy jobs → OpenRouter (Claude) → Gemini → Groq. Leave the model variables
# empty to pick the current model from each vendor's live list.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                 # heavy default, e.g. anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_COMPLEX=         # very complex jobs, e.g. anthropic/claude-opus-5.5
OPENROUTER_MODEL_LIGHT=           # last-resort for light jobs, e.g. anthropic/claude-haiku-...
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Web search: Tavily first, Exa as fallback (and first for semantic queries).
TAVILY_API_KEY=
EXA_API_KEY=

# Page reading: Jina first, Firecrawl as fallback. Site crawling: Firecrawl.
JINA_API_KEY=
FIRECRAWL_API_KEY=

# GitHub (read-only).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Database. With both set and the migration applied, runs and files are
# stored in Supabase; otherwise as JSON under PACT_DATA_DIR.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# PACT_STORAGE=auto            # auto | supabase | file | memory
# PACT_BLOBS=local             # keep raw file bytes on disk even when Supabase is configured
PACT_DATA_DIR=.pact-data

# Agent and cost limits.
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=10
MAX_SEARCH_RESULTS=5
MAX_SOURCE_LENGTH=12000
MAX_CONTEXT_LENGTH=60000
MAX_CRAWL_PAGES=5
MAX_UPLOAD_BYTES=10485760
TOOL_TIMEOUT_MS=25000
LLM_TIMEOUT_MS=60000
PARSER_TIMEOUT_MS=30000
RUN_TIMEOUT_MS=240000

# Frontend: set to "mock" to run the app with the browser-only simulation.
# NEXT_PUBLIC_PACT_CLIENT=mock

# Pact Onchain (hidden surface served on its own subdomain; see docs/onchain.md).
ONCHAIN_HOST=onchain.runpact.family
# The docs host and the main site host. On the main site /docs moves to the docs host.
DOCS_HOST=docs.runpact.family
SITE_HOST=runpact.family
# PACT_ONCHAIN_PREVIEW=1       # also serve the onchain surface under /onchain on any host (testing)
BLOCKSCOUT_API_KEY=           # dev.blockscout.com (free): history, balances, verification on Robinhood Chain
ANKR_API_KEY=                 # ankr.com (freemium): history, balances with prices, holders on Base and BNB
HELIUS_API_KEY=               # Solana RPC and DAS
COINGECKO_API_KEY=            # coingecko.com Demo plan (free): ATH, rank, exchanges, year-long history, global context
NODEREAL_API_KEY=             # nodereal.io MegaNode free plan: BNB Chain RPC, holders and history behind Ankr
ALCHEMY_API_KEY=              # alchemy.com free tier: RPC on Base/BNB/Robinhood/Solana, transfers and priced balances behind Ankr
CODEX_API_KEY=                # codex.io "almost free" plan ($1 activation): token screener, risk metrics, launchpads, events, minute candles on all four chains
